# Copy to .env (git ignores it). Both Makefiles load it.

# The GitHub App for each repo owner, as owner=app_id:key_file pairs separated by commas.
# The key file is the app's private key; keep it outside the repo.
MH_GITHUB_APPS=davecthomas=5659485:~/.config/meta-harness/github-app.pem

# The console web app's access list: the identities that may sign in, separated by commas.
MH_CONSOLE_OPERATORS=you@example.com
# Locally there is no Identity-Aware Proxy, so this identity is the one signed in.
MH_CONSOLE_DEV_IDENTITY=you@example.com
