# Copy to .env (git ignores it). Both Makefiles load it.

# The GitHub App for each repo owner, as owner=app_id:key_file pairs separated by commas.
# The key file is the app's private key; keep it outside the repo.
MH_GITHUB_APPS=owner=123456:~/.config/meta-harness/github-app.pem

# The console web app's access list: the identities that may sign in, separated by commas.
MH_CONSOLE_OPERATORS=you@example.com
# Locally there is no Google sign-in (MH_GOOGLE_CLIENT_ID is unset), so this identity is the one signed in.
MH_CONSOLE_DEV_IDENTITY=you@example.com

# Model providers, as ai-api-unified reads them (its env_template names). Secrets live here only;
# models.json holds everything that is not a secret. Note who owns the keys you put here.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# A Gemini API key from the project the meta-harness deploys in, restricted to the Gemini API.
GOOGLE_GEMINI_API_KEY=
# Google service-account auth, for Vertex only: an absolute path to the key file (env vars do not expand ~).
GOOGLE_APPLICATION_CREDENTIALS=
