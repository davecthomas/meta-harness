{
  "name": "harness-pi",
  "private": true,
  "type": "module",
  "description": "The harness server and model client for the pi harness image: the Run API over pi's SDK, with every model call sent to the HTTP Gateway",
  "scripts": {
    "start": "node server/main.ts",
    "test": "node --test test/server.test.ts test/bash-allowlist.test.ts test/run-record.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.6.1",
    "@earendil-works/pi-coding-agent": "1.6.1",
    "typebox": "1.4.7",
    "undici": "8.13.1"
  },
  "devDependencies": {
    "@types/node": "26.6.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
