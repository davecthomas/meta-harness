# Copy to deploy/.env (git ignores it) and fill in. `make platform` and deploy/shutdown.sh read it, so the
# values that identify people and accounts stay out of the public repo.

# Who may sign in to the console: Google accounts, as a JSON list. CI reads the same from the MH_OPERATORS secret.
TF_VAR_operators=["you@example.com"]
# Who of them is an admin. Leave it out and every operator is one. CI reads the MH_ADMINS secret.
# TF_VAR_admins=["you@example.com"]

# deploy/shutdown.sh. Leave these out to use deploy/environment.json's project and zone, and the defaults shown.
# MH_PROJECT=
# MH_ZONE=
# MH_REPO=davecthomas/meta-harness
# MH_BACKUP_DIR=~/meta-harness-backups
