[Unit]
Description=meta-harness event service, on the VM's private address for the edge
After=mh-migrate.service mh-temporal.service
Requires=mh-migrate.service

[Service]
User=mh
WorkingDirectory=/opt/meta-harness
EnvironmentFile=/etc/meta-harness/env
ExecStart=/opt/meta-harness/.venv/bin/mh events serve --host 0.0.0.0 --port 8301
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
