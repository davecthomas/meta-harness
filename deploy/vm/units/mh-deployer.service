[Unit]
Description=Deploy the meta-harness when the VM's mh-deploy-id metadata changes
# At boot the startup script deploys first; this service then answers later deploys.
After=network-online.target google-startup-scripts.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/mh-deployer watch
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
